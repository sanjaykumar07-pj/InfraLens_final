# InfraLens Environment Configuration
# Copy this file to .env and fill in values
# cp .env.example .env

# Backend
ENV=production
PORT=8000

# Data Storage Paths (used inside Docker)
METADATA_FILE=/data/metadata.json
UPLOAD_DIR=/data/uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost

# File upload limit
MAX_FILE_SIZE_MB=10
